# ---- [2/2] 29-vllm-capture-slot-len-guard.patch ----
# 修复 29：RoutedExpertsManager.get() 增加槽位长度断言（fail-fast）
# 依赖：06_r3/05-vllm
# 问题：block 表覆盖的槽位少于 num_tokens 时，下面的 [:num_tokens] 会静默返回更少的行，
#   下游 as_dict() 左对齐补零后整条 response 路由左移，精度崩坏但全程无报错。
# 修复：短了就抛 RuntimeError，把"少块"暴露在第一现场（28 修好后不会触发）。
#
--- a/vllm/model_executor/layers/fused_moe/routed_experts_capturer.py
+++ b/vllm/model_executor/layers/fused_moe/routed_experts_capturer.py
@@ -396,6 +396,14 @@
         span = self.block_span
         block_ids_array = np.array(block_ids, dtype=np.int64)
         block_offsets = np.arange(span)
+        # R3 fix 29: fail fast instead of silently truncating below. A short
+        # block table shifts every following token's routes by one or more rows.
+        _r3_slots = int(len(block_ids)) * int(block_offsets.shape[0])
+        if _r3_slots < num_tokens:
+            raise RuntimeError(
+                f"RoutedExpertsManager.get: {len(block_ids)} blocks x span {span} = "
+                f"{_r3_slots} slots < num_tokens={num_tokens}"
+            )
