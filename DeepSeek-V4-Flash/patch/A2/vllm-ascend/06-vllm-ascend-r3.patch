# ---- [2/3] 13-vllm-ascend-capture-gate-fix.patch ----
# R3 capture fix for vllm-ascend (vLLM v0.26.0rc / vllm-ascend releases/v0.26.0rc).
# Symptom: every RoutedExpertsManager.store_batch saw nonzero=0 -> the worker
# never wrote routing ids, so R3 replayed "everything to expert 0".
# Root cause: the capture call site gates on get_current_vllm_config(); that
# global is not installed while the worker executes the forward pass, so
# model_config is None and capture() is skipped silently. The gate is also
# wrong on its own: a bound capturer already implies
# enable_return_routed_experts=True (binding happens only inside
# init_routed_experts_capturer(), which runs under that flag).
# Secondary bug fixed here: `layer` is self.routed_experts (RoutedExperts),
# which has no `layer_id` property -- as soon as capture is reached,
# `layer.layer_id` would raise AttributeError. Derive the layer index from
# `layer.layer_name` instead.
# Probe (default off): VERL_R3_PROBE_CAPTURE_ASCEND=1 -> [R3CAPA] one-shot lines.
#
diff --git a/vllm_ascend/ops/fused_moe/fused_moe.py b/vllm_ascend/ops/fused_moe/fused_moe.py
--- a/vllm_ascend/ops/fused_moe/fused_moe.py
+++ b/vllm_ascend/ops/fused_moe/fused_moe.py
@@ -213,15 +213,41 @@
             num_experts=num_logical_experts,
             tid2eid=self.tid2eid,
             input_ids=input_ids,
         )
         try:
             _vllm_config = get_current_vllm_config()
         except AssertionError:
             _vllm_config = None
         model_config = None if _vllm_config is None else _vllm_config.model_config
-        if model_config is not None and model_config.enable_return_routed_experts:
-            capturer = getattr(layer, "_ascend_routed_experts_capturer", None)
-            if capturer is not None:
-                capturer.capture(layer_id=layer.layer_id, topk_ids=topk_ids)
+        # R3 capture: do NOT gate on ``get_current_vllm_config()``. The global
+        # config is not guaranteed to be installed while the worker executes
+        # the forward pass, which silently skipped capture and left every
+        # captured slot at zero. A bound capturer already implies
+        # ``enable_return_routed_experts=True``.
+        capturer = getattr(layer, "_ascend_routed_experts_capturer", None)
+        try:
+            import os as _r3_os
+
+            if _r3_os.environ.get("VERL_R3_PROBE_CAPTURE_ASCEND", "0") == "1":
+                _r3_left = getattr(type(self).apply, "_r3cap_left", 8)
+                if _r3_left > 0:
+                    type(self).apply._r3cap_left = _r3_left - 1
+                    print(
+                        f"[R3CAPA] layer={getattr(layer, 'layer_name', '?')} "
+                        f"capturer={'bound' if capturer is not None else 'None'} "
+                        f"model_config={'None' if model_config is None else model_config.enable_return_routed_experts} "
+                        f"topk={tuple(topk_ids.shape)} "
+                        f"topk_nz={int((topk_ids != 0).sum().item())}",
+                        flush=True,
+                    )
+        except Exception as _r3_exc:  # probe must never break the hot path
+            print(f"[R3CAPA] probe failed: {_r3_exc}", flush=True)
+        if capturer is not None:
+            _r3_layer_id = getattr(layer, "layer_id", None)
+            if _r3_layer_id is None:
+                from vllm.model_executor.models.utils import extract_layer_index
+
+                _r3_layer_id = extract_layer_index(layer.layer_name)
+            capturer.capture(layer_id=_r3_layer_id, topk_ids=topk_ids)
 
         if zero_expert_num > 0 and zero_expert_type is not None:
             topk_ids, topk_weights, zero_expert_result = zero_experts_compute(

# ---- [3/3] 28-vllm-ascend-cdiv-kv-blocks.patch ----
# 正式修复 28（核心）：CompressAttentionManager 块分配向下取整 -> 向上取整
# 依赖：06_r3/06-vllm-ascend（同仓库）
# 根因：路由槽位按逻辑位置寻址 block_ids[p // 128] * 128 + p % 128，覆盖 p 个 token
#   需要 cdiv(p, compress_ratio) 个压缩 token；原实现用 num_tokens // compress_ratio，
#   当 num_tokens % 128 属于 {1,2,3} 时少分配 1 个 block：
#   - Worker 侧 raw_block_ids[req, k] == 0 -> 路由写进 block 0(null block)
#   - Scheduler 侧 get() 读到后分配、从未写入的 block -> 全 0 且静默截断
#   - as_dict() 左对齐补零 -> 整条 response 路由左移 1~2 个 token
# 证据：train10291135.log [R3CAPV] store slot=[0,255] / get slot=[128,13570]，out_nonzero
#   少 72 = 3 行 x 4 层 x 6；train10290248.log [R3CAP] raw=2303 vs out=2305；全部 R3 run
#   的 rollout_rs_token_k1_seq_fraction_high 恒为 0.015625(=1/64)，R3 off 为 0
# 安全性：admission cap 已是 cdiv(max_model_len // compress_ratio, block_size) + 1，
#   提前 1 个 token 分配不会超出池；注意力侧按 metadata.num_compressed_tokens 写入，透明。
#
--- a/vllm_ascend/core/single_type_kv_cache_manager.py
+++ b/vllm_ascend/core/single_type_kv_cache_manager.py
@@ -48,8 +48,10 @@
         # assert isinstance(self.kv_cache_spec, (CompressAttentionSpec, C4IndexerSpec))
 
-        num_tokens //= self.compress_ratio
+        # R3 fix 28: round up. A logical token position p maps to block p // 128,
+        # so covering p tokens needs cdiv(p, compress_ratio) compressed tokens.
+        num_tokens = cdiv(num_tokens, self.compress_ratio)
         if num_tokens_main_model is None:
             assert num_local_computed_tokens is not None
             num_tokens_main_model = num_local_computed_tokens
-        num_tokens_main_model //= self.compress_ratio
+        num_tokens_main_model = cdiv(num_tokens_main_model, self.compress_ratio)
         return super().get_num_blocks_to_allocate(
@@ -146,7 +148,8 @@
             The new allocated blocks.
